# ------------------------------------------------------------------
# EdFlow environment variables. Copy to `.env` and adjust locally.
# `.env` is private and MUST NOT be committed.
# ------------------------------------------------------------------

# --- Core ---
# Use a long random string in production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Hosts allowed to POST (when serving a school LAN hostname/IP).
# CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://192.168.1.10:8000

# --- Database ---
# Leave DB_HOST unset to use SQLite (small dev/prototype only).
# Set DB_HOST to use PostgreSQL (production / LAN server).
DB_HOST=
DB_PORT=5432
DB_NAME=edflow
DB_USER=edflow
DB_PASSWORD=

# --- Admin bootstrap (used by setup_windows.bat / create_admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
ADMIN_EMAIL=admin@school.local

# --- Admin path (disable birds' eye exposure on a LAN): default "admin" ---
# ADMIN_URL=manage-school

# --- Timezone of the school (IANA name) ---
# TIME_ZONE=Asia/Kolkata

# --- Redis / Celery / Channels ---
# Leave unset (or point at a local Redis) in development.
REDIS_URL=redis://127.0.0.1:6379/0

# --- Email (optional add-on) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Android Communication Gateway shared secret (LAN USB/Wi-Fi) ---
# Must match the token configured in the gateway app. When empty, gateway
# endpoints reject all requests.
COMMUNICATION_GATEWAY_TOKEN=

# --- TLS (only when a reverse proxy terminates HTTPS) ---
# COOKIE_SECURE=true
# ENABLE_HSTS=true

# --- Logging level: DEBUG / INFO / WARNING / ERROR ---
# LOG_LEVEL=INFO